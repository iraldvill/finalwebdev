<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Admin — Villaflores Gaming Cafe</title>
<link rel="stylesheet" href="{{ asset('css/admin.css') }}">
<link rel="stylesheet" href="{{ asset('css/admin-extra.css') }}">
</head>
<body>

<aside class="sidebar">
  <div>
    <div class="sidebar-brand">VILLAFLORES <span>GAMING CAFE</span></div>
    <div class="sidebar-welcome">Welcome, {{ adminName }}</div>
  </div>

  <nav class="sidebar-nav">
    <button type="button" class="active" data-tab="dashboard" onclick="showTab('dashboard', this)">
      <span class="icon">▦</span> Dashboard
    </button>
    <button type="button" data-tab="bookings" onclick="showTab('bookings', this)">
      <span class="icon">▤</span> Bookings
    </button>
    <button type="button" data-tab="accounts" onclick="showTab('accounts', this)">
      <span class="icon">◈</span> Accounts
    </button>
    <button type="button" data-tab="stations" onclick="showTab('stations', this)">
      <span class="icon">▥</span> PC Stations
    </button>
    <button type="button" data-tab="reviews" onclick="showTab('reviews', this)">
      <span class="icon">★</span> Reviews
    </button>
  </nav>

  <div class="sidebar-footer">
    <a href="{{ path('app_profile') }}">My Profile</a>
    <a href="{{ path('app_home') }}">← Back to Site</a>
    <a href="{{ path('app_logout') }}">Sign Out</a>
  </div>
</aside>

<div class="content-area">
  <header>
    <div>
      <div class="page-title" id="pageTitle">Dashboard</div>
      <div class="subtitle">Accounts &amp; booking overview</div>
    </div>
    <div class="subtitle">Updated {{ 'now'|date('M j, Y — g:i A') }}</div>
  </header>

  <main>

    {# Messages like "Account created" or "Account deleted" #}
    {% for type, messages in app.flashes %}
      {% for message in messages %}
        <div class="flash flash-{{ type }}">{{ message }}</div>
      {% endfor %}
    {% endfor %}

    {# ===================== DASHBOARD ===================== #}
    <div class="tab-panel active" id="tab-dashboard">
      <div class="stat-grid">
        <div class="stat-card">
          <div class="stat-num">{{ stats.total_users }}</div>
          <div class="stat-label">Registered accounts</div>
        </div>
        <div class="stat-card">
          <div class="stat-num">{{ stats.total_staff }}</div>
          <div class="stat-label">Total staff</div>
        </div>
        <div class="stat-card">
          <div class="stat-num">{{ stats.total_bookings }}</div>
          <div class="stat-label">Total bookings</div>
        </div>
        <div class="stat-card">
          <div class="stat-num">{{ stats.active_bookings }}</div>
          <div class="stat-label">Active / confirmed</div>
        </div>
        <div class="stat-card">
          <div class="stat-num">{{ stats.today_bookings }}</div>
          <div class="stat-label">Booked for today</div>
        </div>
      </div>

      <section class="panel">
        <div class="panel-head">
          <h2>Recent Bookings</h2>
          <span class="count">{{ bookings|length }} total</span>
        </div>
        <table>
          <thead>
            <tr>
              <th>User</th>
              <th>Plan</th>
              <th>Date</th>
              <th>Status</th>
              <th>Payment</th>
            </tr>
          </thead>
          <tbody>
            {% for b in bookings|slice(0, 5) %}
              <tr>
                <td>{{ b.full_name ?? 'Deleted user' }}</td>
                <td>{{ b.plan_name }}</td>
                <td>{{ b.booking_date }}</td>
                <td><span class="badge {{ b.status|lower }}">{{ b.status }}</span></td>
                <td><span class="badge {{ b.payment_status|lower }}">{{ b.payment_status }}</span></td>
              </tr>
            {% else %}
              <tr class="empty-row"><td colspan="5">No bookings yet.</td></tr>
            {% endfor %}
          </tbody>
        </table>
      </section>
    </div>

    {# ===================== BOOKINGS ===================== #}
    <div class="tab-panel" id="tab-bookings">
      <section class="panel">
        <div class="panel-head">
          <h2>All Bookings</h2>
          <span class="count">{{ bookings|length }} total</span>
        </div>
        <div class="filter-bar" data-target="bookings-table">
          <input type="search" data-filter="search" placeholder="Search user, plan, PC…" aria-label="Search bookings">
          <select data-filter="status" aria-label="All statuses"><option value="">All statuses</option><option value="pending">Pending</option><option value="confirmed">Confirmed</option><option value="cancelled">Cancelled</option></select>
          <select data-filter="payment" aria-label="All payments"><option value="">All payments</option><option value="unpaid">Unpaid</option><option value="paid">Paid</option></select>
          <input type="date" data-filter="date" aria-label="Filter by date">
          <button type="button" class="filter-reset">Reset</button>
        </div>
        <table id="bookings-table">
          <thead>
            <tr>
              <th>User</th>
              <th>Plan</th>
              <th>Station(s)</th>
              <th>Date</th>
              <th>Time</th>
              <th>Status</th>
              <th>Payment</th>
              <th>Booked on</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            {% for b in bookings %}
              <tr data-search="{{ ((b.full_name ?? '') ~ ' ' ~ b.plan_name ~ ' ' ~ b.stations ~ ' ' ~ b.booking_date)|lower|e('html_attr') }}" data-status="{{ b.status|lower }}" data-payment="{{ b.payment_status|lower }}" data-date="{{ b.booking_date }}">
                <td>{{ b.full_name ?? 'Deleted user' }}</td>
                <td>{{ b.plan_name }}</td>
                <td>{{ b.stations }}</td>
                <td>{{ b.booking_date }}</td>
                <td>{{ b.booking_time }} – {{ b.booking_time_end }}</td>
                <td><span class="badge {{ b.status|lower }}">{{ b.status }}</span></td>
                <td>
                  {{ b.payment_method ?? '—' }} —
                  <span class="badge {{ b.payment_status|lower }}">{{ b.payment_status }}</span>
                </td>
                <td>{{ b.created_at }}</td>
                <td class="row-actions">
                  <a href="{{ path('app_admin_booking_edit', {id: b.id}) }}" class="edit-btn">Edit</a>

                  {% if b.status|lower == 'pending' %}
                    <form class="delete-form" method="post" action="{{ path('app_admin_booking_status', {id: b.id, action: 'accept'}) }}">
                      <input type="hidden" name="_token" value="{{ csrf_token('booking-status-' ~ b.id) }}">
                      <button type="submit" class="accept-btn">Accept</button>
                    </form>
                    <form class="delete-form" method="post" action="{{ path('app_admin_booking_status', {id: b.id, action: 'reject'}) }}">
                      <input type="hidden" name="_token" value="{{ csrf_token('booking-status-' ~ b.id) }}">
                      <button type="submit" class="reject-btn">Reject</button>
                    </form>
                  {% endif %}
                  {% if b.payment_status|lower != 'paid' %}
                    <form class="delete-form" method="post" action="{{ path('app_admin_booking_paid', {id: b.id}) }}">
                      <input type="hidden" name="_token" value="{{ csrf_token('booking-paid-' ~ b.id) }}">
                      <button type="submit" class="accept-btn">Mark Paid</button>
                    </form>
                  {% endif %}
                  <form class="delete-form" method="post" action="{{ path('app_admin_booking_delete', {id: b.id}) }}"
                        onsubmit="return confirm('Delete this booking? This cannot be undone.');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete-booking-' ~ b.id) }}">
                    <button type="submit" class="delete-btn">Delete</button>
                  </form>
                </td>
              </tr>
            {% else %}
              <tr class="empty-row"><td colspan="9">No bookings yet.</td></tr>
            {% endfor %}
          </tbody>
        </table>
      </section>
    </div>

    {# ===================== ACCOUNTS ===================== #}
    <div class="tab-panel" id="tab-accounts">
      <section class="panel" style="margin-bottom: 20px; padding: 24px;">
        <a href="{{ path('app_admin_user_new') }}" class="add-new-btn">+ Add Account</a>
      </section>

      <section class="panel">
        <div class="panel-head">
          <h2>Registered Accounts</h2>
          <span class="count">{{ users|length }} total</span>
        </div>
        <div class="filter-bar" data-target="accounts-table">
          <input type="search" data-filter="search" placeholder="Search name or email…" aria-label="Search accounts">
          <select data-filter="role" aria-label="All roles"><option value="">All roles</option><option value="admin">Admin</option><option value="staff">Staff</option><option value="customer">Customer</option></select>
          <select data-filter="state" aria-label="All statuses"><option value="">All statuses</option><option value="active">Active</option><option value="disabled">Disabled</option></select>
          <button type="button" class="filter-reset">Reset</button>
        </div>
        <table id="accounts-table">
          <thead>
            <tr>
              <th>Full Name</th>
              <th>Email</th>
              <th>Role</th>
              <th>Status</th>
              <th>Joined</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            {% for u in users %}
              <tr data-search="{{ (u.full_name ~ ' ' ~ u.email)|lower|e('html_attr') }}" data-role="{{ u.role }}" data-state="{{ u.is_active ? 'active' : 'disabled' }}">
                <td>{{ u.full_name }}</td>
                <td>{{ u.email }}</td>
                <td><span class="badge role-{{ u.role }}">{{ u.role }}</span></td>
                <td>
                  <span class="badge {{ u.is_active ? 'confirmed' : 'cancelled' }}">{{ u.is_active ? 'Active' : 'Disabled' }}</span>
                </td>
                <td>{{ u.created_at }}</td>
                <td class="row-actions">
                  <a href="{{ path('app_admin_user_edit', {id: u.id}) }}" class="edit-btn">Edit</a>

                  {# You can't disable or delete the account you are logged in with #}
                  {% if u.id != app.user.id %}
                    <form class="delete-form" method="post" action="{{ path('app_admin_user_toggle', {id: u.id}) }}">
                      <input type="hidden" name="_token" value="{{ csrf_token('toggle-user-' ~ u.id) }}">
                      <button type="submit" class="{{ u.is_active ? 'reject-btn' : 'accept-btn' }}">{{ u.is_active ? 'Disable' : 'Enable' }}</button>
                    </form>

                    <form class="delete-form" method="post" action="{{ path('app_admin_user_delete', {id: u.id}) }}"
                          onsubmit="return confirm('Delete this account? Their bookings and reviews will be deleted too. This cannot be undone.');">
                      <input type="hidden" name="_token" value="{{ csrf_token('delete-user-' ~ u.id) }}">
                      <button type="submit" class="delete-btn">Delete</button>
                    </form>
                  {% endif %}
                </td>
              </tr>
            {% else %}
              <tr class="empty-row"><td colspan="6">No accounts yet.</td></tr>
            {% endfor %}
          </tbody>
        </table>
      </section>
    </div>

    {# ===================== PC STATIONS ===================== #}
    <div class="tab-panel" id="tab-stations">
      <section class="panel" style="padding: 24px;">
        <div class="pc-legend">
          <span><span class="swatch idle"></span> Available</span>
          <span><span class="swatch occupied"></span> Reserved today</span>
        </div>
        <p style="font-size: 12px; color: var(--muted-foreground); margin-bottom: 20px;">
          Shows today's actual PC assignments — customers now pick their specific station number when booking.
        </p>
        <div class="pc-grid">
          {% for n in 1..totalStations %}
            {% set assigned = pcAssignments[n] %}
            <div class="pc-card {{ assigned ? 'occupied' : '' }}">
              <div class="pc-card-name">PC {{ n }}</div>
              {% if assigned %}
                <span class="pc-card-status">Reserved</span>
                <div class="pc-card-detail">
                  {{ assigned.full_name ?? 'Deleted user' }}<br>
                  {{ assigned.plan_name }} — {{ assigned.booking_time }}–{{ assigned.booking_time_end }}
                </div>
              {% else %}
                <span class="pc-card-status">Idle</span>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      </section>
    </div>

    {# ===================== REVIEWS ===================== #}
    <div class="tab-panel" id="tab-reviews">
      <section class="panel">
        <div class="panel-head">
          <h2>Customer Reviews</h2>
          <span class="count">{{ reviews|length }} total</span>
        </div>
        <div class="filter-bar" data-target="reviews-table">
          <input type="search" data-filter="search" placeholder="Search user or feedback…" aria-label="Search reviews">
          <select data-filter="rating" aria-label="All ratings"><option value="">All ratings</option><option value="5">5 stars</option><option value="4">4 stars</option><option value="3">3 stars</option><option value="2">2 stars</option><option value="1">1 star</option></select>
          <button type="button" class="filter-reset">Reset</button>
        </div>
        <table id="reviews-table">
          <thead>
            <tr>
              <th>User</th>
              <th>Rating</th>
              <th>Feedback</th>
              <th>Posted on</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            {% for r in reviews %}
              <tr data-search="{{ ((r.full_name ?? '') ~ ' ' ~ (r.comment ?? ''))|lower|e('html_attr') }}" data-rating="{{ r.rating }}">
                <td>{{ r.full_name ?? 'Deleted user' }}</td>
                <td style="color: var(--pink); letter-spacing: 2px;">
                  {% for i in 1..5 %}{{ i <= r.rating ? '★' : '☆' }}{% endfor %}
                </td>
                <td>
                  {% if r.comment %}
                    {{ r.comment|nl2br }}
                  {% else %}
                    <span style="color: var(--muted-foreground);">—</span>
                  {% endif %}
                </td>
                <td>{{ r.created_at }}</td>
                <td class="row-actions">
                  <a href="{{ path('app_admin_review_edit', {id: r.id}) }}" class="edit-btn">Edit</a>
                  <form class="delete-form" method="post" action="{{ path('app_admin_review_delete', {id: r.id}) }}"
                        onsubmit="return confirm('Delete this review? This cannot be undone.');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete-review-' ~ r.id) }}">
                    <button type="submit" class="delete-btn">Delete</button>
                  </form>
                </td>
              </tr>
            {% else %}
              <tr class="empty-row"><td colspan="5">No reviews yet.</td></tr>
            {% endfor %}
          </tbody>
        </table>
      </section>
    </div>

  </main>
</div>

<script src="{{ asset('js/admin.js') }}"></script>
<script src="{{ asset('js/admin-filter.js') }}"></script>
</body>
</html>
