<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Bookings — Villaflores Gaming Cafe</title>
    <link rel="stylesheet" href="{{ asset('css/style.css') }}">
    <link rel="stylesheet" href="{{ asset('css/auth.css') }}">
    <link rel="stylesheet" href="{{ asset('css/staff.css') }}">
</head>
<body>

<div class="auth-wrapper brand-grid">
    <div class="auth-card staff-card staff-wide">
        <a href="{{ path('app_home') }}">
            <img src="{{ asset('images/logo.png') }}" alt="Villaflores Gaming Cafe Logo" class="auth-logo">
        </a>

        <h1 class="auth-title">My Bookings</h1>
        <p class="staff-subtitle">Your booking requests and their status</p>

        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <div class="{{ type == 'success' ? 'auth-success' : 'auth-error' }}">{{ message }}</div>
            {% endfor %}
        {% endfor %}

        <div class="staff-toolbar">
            <a href="{{ path('app_booking_new') }}" class="staff-add-btn">+ Book a Seat</a>
            <span class="count">{{ bookings|length }} total</span>
        </div>

        <div class="staff-table-wrap">
            <table class="staff-table">
                <thead>
                    <tr>
                        <th>Plan</th>
                        <th>PC(s)</th>
                        <th>Date</th>
                        <th>Time</th>
                        <th>Status</th>
                        <th>Payment</th>
                        <th>Amount</th>
                    </tr>
                </thead>
                <tbody>
                    {% for b in bookings %}
                        <tr>
                            <td>{{ b.plan }}</td>
                            <td>{{ b.stations }}</td>
                            <td>{{ b.date_label }}</td>
                            <td>{{ b.time }}</td>
                            <td><span class="s-badge {{ b.status|lower }}">{{ b.status }}</span></td>
                            <td>
                                {{ b.payment_method ?? '—' }}
                                <span class="s-badge {{ b.payment_status|lower }}">{{ b.payment_status }}</span>
                            </td>
                            <td>₱{{ b.amount }}</td>
                        </tr>
                    {% else %}
                        <tr class="empty-row"><td colspan="7">You have no bookings yet.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="profile-links">
            <a href="{{ path('app_home') }}">← Back to Site</a>
            <a href="{{ path('app_profile') }}">My Profile</a>
            <a href="{{ path('app_logout') }}">Logout</a>
        </div>
    </div>
</div>

</body>
</html>
